# Current branch image for testing; pin a published sha-<full-commit> tag or digest for deployments.
WEAVE_IMAGE=ghcr.io/weavecloudspace-repo/weave-cbt-production-repository:implementing-services

# Local PostgreSQL settings.
POSTGRES_USER=weave
POSTGRES_PASSWORD=change-this-to-a-long-random-alphanumeric-password
POSTGRES_DB=weave_cbt

# Runtime values supplied to the CLI through --env-file.
ENVIRONMENT=prod
WEAVE_API_BASE_URL=https://api.weavecloudspace.com
DATABASE_URL=postgresql+asyncpg://weave:change-this-to-a-long-random-alphanumeric-password@postgres:5432/weave_cbt
REDIS_URL=redis://redis:6379/0
DEBUG=false
