{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:staff",
    "dev:staff": "vite --config vite.staff.config.js",
    "dev:student": "vite --config vite.student.config.js",
    "build": "npm run build:staff && npm run build:student",
    "build:staff": "vite build --config vite.staff.config.js",
    "build:student": "vite build --config vite.student.config.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "npm run preview:staff",
    "preview:staff": "vite preview --config vite.staff.config.js",
    "preview:student": "vite preview --config vite.student.config.js"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
